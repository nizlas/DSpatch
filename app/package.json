{
  "name": "dspatch",
  "productName": "DSpatch",
  "version": "0.1.0",
  "private": true,
  "description": "DSpatch – arbetsyta för agentassisterad utveckling. Körbart skelett från DSP-1 delsteg 2.",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:renderer",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "dev": "npm run build:node && node scripts/dev.mjs",
    "start": "electron .",
    "package": "npm run build && electron-builder --config electron-builder.yml",
    "typecheck": "npm run typecheck:node && npm run typecheck:renderer && npm run typecheck:tools",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
