{
  "name": "dspatch",
  "productName": "DSpatch",
  "version": "0.1.0",
  "private": true,
  "description": "DSpatch – a workspace for agent-assisted development. Runnable skeleton from DSP-1 substep 2.",
  "license": "UNLICENSED",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run build:node && npm run build:renderer && npm run build:identity",
    "build:identity": "node scripts/build-identity.mjs",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "dev": "npm run build:node && node scripts/dev.mjs",
    "editor": "npm run build:node && node scripts/editor.mjs",
    "loop:dry-run": "node --import ./scripts/ts-resolve.mjs scripts/run-loop-graph.mjs",
    "loop:live": "node --import ./scripts/ts-resolve.mjs scripts/run-loop-graph.mjs --live",
    "roles:generate": "node --import ./scripts/ts-resolve.mjs scripts/generate-roles.mjs",
    "start": "electron .",
    "test": "node scripts/run-tests.mjs all",
    "test:fast": "node scripts/run-tests.mjs fast",
    "test:heavy": "node scripts/run-tests.mjs heavy",
    "test:presentation": "node scripts/run-tests.mjs presentation",
    "test:loop": "node scripts/run-tests.mjs loop",
    "test:chat": "node scripts/run-tests.mjs chat",
    "test:project": "node scripts/run-tests.mjs project",
    "test:live": "node scripts/run-tests.mjs live",
    "test:list": "node scripts/run-tests.mjs --list",
    "package": "npm run typecheck && npm run test && npm run build && electron-builder --config electron-builder.yml",
    "typecheck": "npm run typecheck:node && npm run typecheck:renderer && npm run typecheck:tools",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@cursor/sdk": "1.0.31",
    "diff": "9.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
