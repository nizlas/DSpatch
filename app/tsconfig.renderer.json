{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true
  },
  "include": ["src/renderer", "src/shared", "src/adapter"],
  // Main-process adapters require a provider SDK and Node built-ins. The renderer
  // must never import them; excluding them here turns a mistake into a failed
  // typecheck instead of a failure inside the packaged artifact.
  "exclude": ["src/adapter/cursor-sdk-adapter.ts", "src/adapter/claude-agent-sdk-adapter.ts"]
}
