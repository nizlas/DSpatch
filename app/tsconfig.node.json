{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Node18 mode produces CommonJS output because package.json has no "type".
    // The main process and preload are not bundled; they resolve node_modules normally.
    "module": "node18",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/main", "src/preload", "src/shared", "src/adapter"]
}
