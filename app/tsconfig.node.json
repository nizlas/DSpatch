{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Node18-läget ger CommonJS-utmatning eftersom package.json saknar "type".
    // Huvudprocessen och preload buntas inte; de ska lösa node_modules normalt.
    "module": "node18",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/main", "src/preload", "src/shared", "src/adapter"]
}
